#!/bin/bash
# Install OpenVPN and pull the PKI from SSM. Certificates are not in this
# file. A failure here leaves Session Manager up so the cloud-init log
# can be read without SSH.
set -euo pipefail
umask 022

echo "openvpn user-data: swap"
if ! swapon --show | grep -q /swapfile; then
  if ! fallocate -l 1G /swapfile; then
    dd if=/dev/zero of=/swapfile bs=1M count=1024
  fi
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  if ! grep -q /swapfile /etc/fstab; then
    echo '/swapfile none swap sw 0 0' >> /etc/fstab
  fi
fi

echo "openvpn user-data: packages"
installed=0
attempt=1
while [ "$attempt" -le 6 ]; do
  if dnf install -y python3 openvpn iptables amazon-cloudwatch-agent; then
    installed=1
    break
  fi
  echo "openvpn user-data: dnf failed, retry $attempt" >&2
  attempt=$((attempt + 1))
  sleep 10
done
if [ "$installed" -ne 1 ]; then
  echo "openvpn user-data: package install failed" >&2
  exit 1
fi

if ! getent group openvpn >/dev/null; then
  echo "openvpn user-data: the openvpn group is required so the daemon can enter /etc/openvpn/server" >&2
  exit 1
fi
runtime_user=nobody
if getent passwd openvpn >/dev/null; then
  runtime_user=openvpn
elif ! getent passwd nobody >/dev/null; then
  echo "openvpn user-data: neither the openvpn user nor nobody exists" >&2
  exit 1
fi

if ! systemctl cat openvpn-server@.service >/dev/null 2>&1; then
  echo "openvpn user-data: openvpn-server@.service is missing" >&2
  systemctl list-unit-files '*openvpn*' >&2 || true
  exit 1
fi

install -d -m 0755 /var/log/openvpn /usr/local/sbin /etc/systemd/system /opt/aws/amazon-cloudwatch-agent/etc
install -d -m 0750 /etc/openvpn/server/ccd

cat > /usr/local/sbin/openvpn-sync <<'OPENVPN_SYNC_SCRIPT_END'
${sync_script}
OPENVPN_SYNC_SCRIPT_END
chmod 0755 /usr/local/sbin/openvpn-sync

install -d -m 0755 /usr/local/lib
cat > /usr/local/lib/render-access.py <<'OPENVPN_RENDER_ACCESS_END'
${render_script}
OPENVPN_RENDER_ACCESS_END
chmod 0755 /usr/local/lib/render-access.py

cat > /usr/local/sbin/openvpn-access <<'OPENVPN_ACCESS_END'
${access_script}
OPENVPN_ACCESS_END
chmod 0755 /usr/local/sbin/openvpn-access

cat > /etc/openvpn/access.yaml <<'OPENVPN_ACCESS_YAML_END'
${access_yaml}
OPENVPN_ACCESS_YAML_END
chmod 0644 /etc/openvpn/access.yaml

cat > /etc/openvpn/server/server.conf <<'OPENVPN_SERVER_CONF_END'
${server_conf}
OPENVPN_SERVER_CONF_END
sed -i "s/^user .*/user $${runtime_user}/" /etc/openvpn/server/server.conf
sed -i "s/^group .*/group openvpn/" /etc/openvpn/server/server.conf
chown root:openvpn /etc/openvpn/server /etc/openvpn/server/ccd /etc/openvpn/server/server.conf
chmod 0750 /etc/openvpn/server /etc/openvpn/server/ccd
chmod 0640 /etc/openvpn/server/server.conf

%{ if peer_gonetlogo ~}
cat > /usr/local/sbin/openvpn-nat <<'OPENVPN_NAT_SCRIPT_END'
${nat_script}
OPENVPN_NAT_SCRIPT_END
chmod 0755 /usr/local/sbin/openvpn-nat

cat > /etc/systemd/system/openvpn-nat.service <<'OPENVPN_NAT_UNIT_END'
[Unit]
Description=Masquerade VPN clients toward the peered GoNetLogo VPC
After=network-online.target
Before=openvpn-server@server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/openvpn-nat ${vpn_cidr} ${gonetlogo_cidr}

[Install]
WantedBy=multi-user.target
OPENVPN_NAT_UNIT_END
%{ endif ~}

cat > /etc/systemd/system/openvpn-sync.service <<'OPENVPN_SYNC_UNIT_END'
${sync_service}
OPENVPN_SYNC_UNIT_END

cat > /etc/systemd/system/openvpn-sync.timer <<'OPENVPN_SYNC_TIMER_END'
${sync_timer}
OPENVPN_SYNC_TIMER_END

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'OPENVPN_CWAGENT_END'
${cwagent_json}
OPENVPN_CWAGENT_END

touch /var/log/openvpn/server.log /var/log/openvpn/firewall.log
chmod 0644 /var/log/openvpn/server.log /var/log/openvpn/firewall.log

cat > /etc/systemd/system/openvpn-fwlog.service <<'OPENVPN_FWLOG_END'
[Unit]
Description=Send rate-limited OpenVPN forward drops to a file
After=systemd-journald.service

[Service]
ExecStart=/bin/bash -c "journalctl -kf -o cat -n 0 | grep --line-buffered -F openvpn-drop:"
StandardOutput=append:/var/log/openvpn/firewall.log
Restart=always

[Install]
WantedBy=multi-user.target
OPENVPN_FWLOG_END

echo "openvpn user-data: sync PKI"
/usr/local/sbin/openvpn-sync

systemctl daemon-reload
%{ if peer_gonetlogo ~}
systemctl enable --now openvpn-nat.service
%{ endif ~}
systemctl enable --now openvpn-fwlog.service
systemctl enable --now openvpn-server@server
systemctl enable --now openvpn-sync.timer

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

echo "openvpn user-data: done"
